        target_content: "  useEffect(() => {\n    if (mode === AppMode.ANALYZING && prefs.disability === UserDisability.VISUAL) {\n        if (\'speechSynthesis\' in window) {\n            window.speechSynthesis.cancel(); // Clears any queued speech\n            let text = \"Image uploaded successfully. I am now analyzing the image under Hear Images mode. Please wait...\";\n            let langCode = \"en-US\";\n            \n            if (prefs.language === \"Hindi\" || prefs.language === \"Hinglish\") {\n                text = \"\340\244\232\340\244\277\340\244\244\340\245\215\340\244\260 \340\244\270\340\244\253\340\244\262\340\244\244\340\244\276\340\244\252\340\245\202\340\244\260\340\245\215\340\244\265\340\244\225 \340\244\205\340\244\252\340\244\262\340\245\213\340\244\241 \340\244\271\340\245\213 \340\244\227\340\244\257\340\244\276 \340\244\271\340\245\210\340\245\244 \340\244\256\340\245\210\340\244\202 \340\244\205\340\244\254 \340\244\207\340\244\270\340\244\225\340\244\276 \340\244\265\340\244\277\340\244\266\340\245\215\340\244\262\340\245\207\340\244\267\340\244\243 \340\244\225\340\244\260 \340\244\260\340\244\271\340\244\276 \340\244\271\340\245\202\340\244\201, \340\244\225\340\245\203\340\244\252\340\244\257\340\244\276 \340\244\252\340\245\215\340\244\260\340\244\244\340\245\200\340\244\225\340\245\215\340\244\267\340\244\276 \340\244\225\340\244\260\340\245\207\340\244\202...\";\n                langCode = \"hi-IN\";\n            } else if (prefs.language === \"Spanish\") {\n                text = \"Imagen subida con \303\251xito. Ahora estoy analizando la imagen. Por favor, espere...\";\n                langCode = \"es-ES\";\n            } else if (prefs.language === \"French\") {\n                text = \"Image t\303\251l\303\251charg\303\251e avec succ\303\250s. J\'analyse l\'image maintenant. S\'il vous pla\303\256t, attendez...\";\n                langCode = \"fr-FR\";\n            } else if (prefs.language === \"Tamil\") {\n            